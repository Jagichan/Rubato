// Resource script of Rubato: application icon and version information.
#include <windows.h>

// The lowest icon ID is the one Explorer shows for Rubato.exe; main.cpp loads the same icon as resource 1.
1 ICON "rubato.ico"

// Start-up splash picture (JPEG), loaded by main.cpp as RCDATA resource 2.
2 RCDATA "splash_screen.jpg"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,4,0,0
 PRODUCTVERSION 1,4,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Jagannatha Rao (JagiChan)"
            VALUE "FileDescription", "Rubato - MIDI humanizer"
            VALUE "FileVersion", "1.4.0.0"
            VALUE "InternalName", "Rubato"
            VALUE "LegalCopyright", "Copyright (C) 2026 O.Jagannatha Rao. GNU General Public License v3 or later"
            VALUE "OriginalFilename", "Rubato.exe"
            VALUE "ProductName", "Rubato"
            VALUE "ProductVersion", "1.4.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
